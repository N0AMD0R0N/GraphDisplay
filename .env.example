# Copy to .env to override the defaults used by docker/compose.yaml and `npm run dev`.
NEO4J_PASSWORD=graphdisplay-dev
DAL_REPLICAS=2
CACHE_TTL_SECONDS=86400
EXPIRY_SWEEP_INTERVAL_SECONDS=300
NEO4J_TX_TIMEOUT_MS=5000
MAX_HOPS=50
DEFAULT_LIMIT=1000
MAX_UPLOAD_BYTES=52428800
SINK_KINDS=rds,sqs
SEED_PIN=true
SEED_NAME=train-ticket-be
# Published localhost ports
CLIENT_PORT=8080
SERVER_PORT=3001
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
REDIS_PORT=6379
# Addresses and ports inside the compose network (the same names are in k8s/configmap.yaml)
NEO4J_HOST=neo4j
NEO4J_USER=neo4j
REDIS_HOST=redis
DAL_HOST=dal
DAL_LB_HOST=dal-lb
DAL_PORT=4000
INGEST_HOST=ingest
INGEST_PORT=5000
SERVER_HOST=server
API_PORT=3000
